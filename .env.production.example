# ==============================================================================
# JANSAHAYAK — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in production and fill in real secrets.
# NEVER commit real production keys or credentials to version control.

# ------------------------------------------------------------------------------
# 1. Django Core Security
# ------------------------------------------------------------------------------
DJANGO_ENV=production
DJANGO_DEBUG=False
# Generate a strong 50+ character random key:
# python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-a-very-long-random-secret-key-at-least-50-characters

# Comma-separated domains/IPs allowed to serve requests
DJANGO_ALLOWED_HOSTS=jansahayak.gov.in,api.jansahayak.gov.in,127.0.0.1,localhost

# Strict CORS and CSRF trusted origins for frontend
CORS_ALLOWED_ORIGINS=https://jansahayak.gov.in,https://app.jansahayak.gov.in
CSRF_TRUSTED_ORIGINS=https://jansahayak.gov.in,https://app.jansahayak.gov.in

# HTTPS and Cookie Enforcement
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Rate limits (throttling)
THROTTLE_RATE_ANON=30/minute
THROTTLE_RATE_USER=150/minute

# ------------------------------------------------------------------------------
# 2. Production Database (PostgreSQL)
# ------------------------------------------------------------------------------
DB_NAME=jansahayak_prod
DB_USER=jansahayak_app
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. AI Service Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Get your production key from Google AI Studio / GCP Console
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 4. Email Service (SMTP for Citizen OTPs & Updates)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@jansahayak.gov.in
EMAIL_HOST_PASSWORD=your_app_specific_email_password
DEFAULT_FROM_EMAIL=JanSahayak Citizen Support <notifications@jansahayak.gov.in>

# ------------------------------------------------------------------------------
# 5. Frontend Environment (Build time for Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.jansahayak.gov.in/api

